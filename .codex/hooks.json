{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/uolle/Developer/whoa-projects/whoa-stash/.codex/hooks/pre-edit.cjs'"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/uolle/Developer/whoa-projects/whoa-stash/.codex/hooks/context-snapshot.cjs'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/uolle/Developer/whoa-projects/whoa-stash/.codex/hooks/context-snapshot.cjs'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node '/Users/uolle/Developer/whoa-projects/whoa-stash/.codex/hooks/context-guard.cjs'"
          }
        ]
      }
    ]
  }
}

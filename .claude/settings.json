{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.git/**)",
      "Read(.DS_Store)",
      "Read(**/.DS_Store/**)",
      "Read(*.log)",
      "Read(**/tmp/**)",
      "Read(**/.idea/**)",
      "Read(/.claude-kit/index/**)",
      "Read(.env)",
      "Read(**/.env/**)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(id_rsa*)",
      "Read(/*.xcodeproj/xcuserdata/**)",
      "Read(/*.xcodeproj/project.xcworkspace/xcuserdata/**)",
      "Read(**/DerivedData/**)",
      "Read(**/Build/**)",
      "Read(**/.build/**)",
      "Read(**/*.swiftpm/**)",
      "Read(**/.swiftpm/**)",
      "Read(**/.vscode/**)",
      "Read(*.swp)",
      "Read(*.swo)",
      "Read(*~)",
      "Read(*.p12)",
      "Read(*.cer)",
      "Read(*.mobileprovision)",
      "Read(*.provisionprofile)",
      "Read(*.keychain)",
      "Read(*.keychain-db)",
      "Read(/Config/Local.xcconfig)",
      "Read(/.claude/settings.local.json)",
      "Read(/.claude/worktrees/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-edit.cjs\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-snapshot.cjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-snapshot.cjs\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/context-guard.cjs\""
          }
        ]
      }
    ]
  },
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/statusline/token-budget.cjs\"",
    "padding": 0
  }
}
